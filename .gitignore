.idea/
__pycache__/
*.pyc

# Regenerable intermediates: target synthetic datasets, shadow models,
# extracted features, meta-classifiers.  Rebuild with scripts/build_targets.py
# and scripts/run_experiment.py.
artifacts/
logs/

# Legacy output tree from the pre-refactor pipeline (see legacy/).
mia_output/

# Results are tracked, but keep the heavy per-run score files out of diffs
# only if they grow unmanageable -- currently they are small and kept.

# CatBoost writes a training log beside the working directory on every fit.
catboost_info/
# Lock and staging files for the concurrent result writers (mia/csvlock.py).
results/*.lock
results/*.tmp
results/*.tmp.*

# Claude Code session worktrees (full copies of the repo).
.claude/

# Per-record score dumps and per-target part files of the perturbation
# experiments (scripts/perturb/); the CSVs beside them are tracked.
results/perturb/donor_linked_scores*/
results/perturb/*_parts*/
